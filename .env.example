APP_NAME=AI Coding Assistant
PORT=8000
SECRET_KEY=change-this-to-a-long-random-string
OPENAI_API_KEY=
# Point at any OpenAI-compatible endpoint instead of OpenAI itself, e.g. a local
# Ollama server: OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_MODEL=llama3.1,
# OPENAI_API_KEY=ollama (Ollama ignores the key's value but the SDK requires one).
# Leave empty to use OpenAI's real API.
OPENAI_BASE_URL=
# Folder the server may read for POST /ingest/path. Leave empty to disable path ingestion.
INGEST_ROOT=
